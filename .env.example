# =============================================================================
# AEGIS Rx Environment Configuration Template
# Copy this file to .env and configure your credentials.
# Do NOT commit your active .env file or sensitive secrets to version control.
# =============================================================================

# --- PRIMARY DATABASE CONFIGURATION (PostgreSQL / Neon) ------------------------
# Neon Serverless PostgreSQL (Recommended / Production Target):
DATABASE_URL=postgresql+psycopg2://[username]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require&channel_binding=require

# Alternative - Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/aegis_rx

# Alternative - Local SQLite (Optional Test / Development Fallback):
# DATABASE_URL=sqlite:///./aegis_rx.db

# --- CONNECTION POOLING CONFIGURATION -----------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# --- SECURITY & AUTHENTICATION ------------------------------------------------
# Comma-separated trusted origins for Cross-Origin Resource Sharing (CORS)
AEGIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Session token expiration duration in hours (default: 24)
AEGIS_SESSION_EXPIRY_HOURS=24

# --- AUDIT LEDGER (Optional Override) -----------------------------------------
# Defaults to DATABASE_URL if unset
# AEGIS_AUDIT_DB_PATH=postgresql+psycopg2://[username]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
